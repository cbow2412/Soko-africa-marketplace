{
  "compilerOptions": {
    "noEmit": false,
    "module": "CommonJS",
    "target": "ES2020",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "server/workers/heartbeat-sync-v2.ts",
    "server/db.ts",
    "server/_core/env.ts",
    "drizzle/schema.ts"
  ]
}
